generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum user_role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  BLOWING_OPERATOR
  FILLING_OPERATOR
  LABELING_OPERATOR
  PACKING_OPERATOR
}

model users {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username        String            @unique @db.VarChar(100)
  password_hash   String            @db.VarChar(255)
  role            user_role
  is_active       Boolean?          @default(true)
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  user_permissions user_permissions[]
}

model user_permissions {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?   @db.Uuid
  form_schema Json
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  users       users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model lines {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique @db.VarChar(50)
}

model brands {
  id       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String     @unique @db.VarChar(50)
  products products[]
}

model products {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand_id  String? @db.Uuid
  name      String  @db.VarChar(100)
  volume_ml Int
  brands    brands? @relation(fields: [brand_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model shifts {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.VarChar(50)
  start_time   DateTime @db.Time(6)
  end_time     DateTime @db.Time(6)
  is_cross_day Boolean? @default(false)
}

model production_batches {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_code      String            @unique @db.VarChar(50)
  line_id         String            @db.Uuid
  brand_id        String            @db.Uuid
  product_id      String            @db.Uuid
  shift_id        String            @db.Uuid
  factory_id      String            @db.Uuid
  start_time      DateTime          @default(now()) @db.Timestamp(6)
  end_time        DateTime?         @db.Timestamp(6)
  status          batch_status      @default(RUNNING)
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  deleted_at      DateTime?         @db.Timestamp(6)

  production_logs production_logs[]
}

model production_logs {
  id             BigInt            @id @default(autoincrement())
  request_id     String            @unique @db.Uuid
  batch_id       String            @db.Uuid
  line_id        String            @db.Uuid
  station        station_type
  primary_count  Int               @default(0)
  logged_at      DateTime          @db.Timestamp(6)
  received_at    DateTime          @default(now()) @db.Timestamp(6)

  production_batches production_batches @relation(fields: [batch_id], references: [id], onDelete: Cascade)
}

enum batch_status {
  PLANNING
  RUNNING
  CHANGEOVER
  QC_PENDING
  COMPLETED
  CLOSED
}

enum station_type {
  BLOWING
  FILLING
  LABELING
  PACKING
}
